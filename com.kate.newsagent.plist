<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kate.newsagent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/katemikhailova/Downloads/news_agent_project_1/run_agent.sh</string>
    </array>

    <!-- Runs every day at 8:00 AM local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/katemikhailova/Downloads/news_agent_project_1/logs/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/katemikhailova/Downloads/news_agent_project_1/logs/stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
